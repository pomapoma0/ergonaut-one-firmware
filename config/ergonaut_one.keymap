#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define DEF 0
#define LWR 1
#define RSE 2
#define ADJ 3

&lt { quick-tap-ms = <200>; };

&mt { quick-tap-ms = <200>; };

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri-layer {
            if-layers = <4 4>;
            then-layer = <4>;
        };
    };

    combos { compatible = "zmk,combos"; };

    macros {
        HankakuKakkoHidiri: HankakuKakko {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(SPACE) &kp LEFT_PARENTHESIS &kp LC(SPACE)>;
            label = "HANKAKUKAKKO";
        };

        HankakuKakkoMigi: HankakuKakkoHidiari {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(SPACE) &kp RIGHT_PARENTHESIS &kp LC(SPACE)>;
            label = "HANKAKUKAKKOHIDIARI";
        };

        f13lay6: f13lay6 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&mo 0 &kp F13>;
            label = "F13LAY6";
        };
    };

    behaviors {
        ef13laym: ef13laym {
            compatible = "zmk,behavior-hold-tap";
            label = "EF13LAYM";
            bindings = <&f13lay6>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Main {
            display-name = "Main";
            bindings = <
&kp TAB       &kp Q  &kp L  &kp U                    &kp COMMA    &kp PERIOD      &kp F          &kp W        &kp R         &kp Y  &kp P    &kp DEL
&kp LEFT_ALT  &kp E  &kp I  &kp A                    &kp O        &kp MINUS       &kp K          &kp T        &kp N         &kp S  &lt 3 H  &kp SLASH
&kp LEFT_WIN  &kp X  &kp Z  &kp C                    &kp V        &kp SQT         &kp G          &kp D        &kp M         &kp J  &kp B    &kp RIGHT_SHIFT
                            &mt LCTRL LC(RC(SPACE))  &lt 2 SPACE  &kp LEFT_SHIFT  &kp BACKSPACE  &lt 1 ENTER  &lt 2 ESCAPE
            >;
        };

        symbol {
            display-name = "Left";
            bindings = <
&trans  &kp AMPERSAND  &kp HASH         &kp AT_SIGN   &trans     &trans  &kp BACKSLASH  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp LEFT_BRACE  &kp RIGHT_BRACE   &trans
&trans  &kp QUESTION   &kp EXCLAMATION  &kp SLASH     &kp EQUAL  &trans  &kp COLON      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LESS_THAN   &kp GREATER_THAN  &trans
&trans  &kp PERCENT    &kp CARET        &kp ASTERISK  &kp GRAVE  &trans  &kp SEMICOLON  &HankakuKakkoHidiri   &HankakuKakkoMigi      &kp INT3        &kp DOLLAR        &trans
                                        &trans        &trans     &trans  &trans         &trans                &trans
            >;
        };

        Number {
            display-name = "Conflg";
            bindings = <
&trans  &kp F11  &kp F12  &kp F11  &trans  &trans   &kp MINUS     &kp N7        &kp N8        &kp N9        &kp PERIOD  &trans
&trans  &kp F6   &kp F7   &kp F8   &kp F9  &kp F10  &kp PLUS      &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp N0      &kp COMMA
&trans  &kp F1   &kp F2   &kp F3   &kp F4  &kp F5   &kp ASTERISK  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp EQUAL   &kp SLASH
                          &trans   &trans  &trans   &trans        &trans        &trans
            >;
        };

        Others {
            bindings = <
&sys_reset      &trans      &trans  &trans  &trans  &bt BT_NXT  &trans             &kp PAGE_UP     &kp UP_ARROW     &kp PAGE_DOWN  &trans   &trans
&bootloader     &trans      &trans  &trans  &trans  &bt BT_NXT  &kp K_SCROLL_UP    &kp LEFT_ARROW  &kp DOWN         &kp RIGHT      &none    &trans
&bt BT_CLR_ALL  &bt BT_CLR  &trans  &trans  &trans  &bt BT_NXT  &kp K_SCROLL_DOWN  &msc SCRL_LEFT  &msc SCRL_RIGHT  &kp HOME       &kp END  &to 4
                                    &trans  &trans  &trans      &trans             &trans          &trans
            >;
        };

        Game {
            bindings = <
&kp ESCAPE      &kp TAB  &kp Q  &kp W     &kp E      &kp R      &kp F3  &kp N7        &kp N8        &kp N9        &none   &to 0
&kp LEFT_SHIFT  &kp G    &kp A  &kp S     &kp D      &kp F      &kp F2  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp N0  &to 0
&kp LCTRL       &kp B    &kp Z  &kp X     &kp C      &kp V      &kp F1  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp F4  &to 0
                                &kp LEFT  &kp SPACE  &kp RIGHT  &trans  &trans        &trans
            >;
        };
    };
};
