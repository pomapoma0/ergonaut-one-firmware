#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define DEF 0
#define LWR 1
#define RSE 2
#define ADJ 3

&lt { quick-tap-ms = <200>; };

&mt { quick-tap-ms = <200>; };

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri-layer {
            if-layers = <4 4>;
            then-layer = <4>;
        };
    };

    combos { compatible = "zmk,combos"; };

    macros {
        HankakuKakkoHidiri: HankakuKakko {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(SPACE) &kp LEFT_PARENTHESIS &kp LC(SPACE)>;
            label = "HANKAKUKAKKO";
        };

        HankakuKakkoMigi: HankakuKakkoHidiari {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(SPACE) &kp RIGHT_PARENTHESIS &kp LC(SPACE)>;
            label = "HANKAKUKAKKOHIDIARI";
        };

        f13lay6: f13lay6 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&mo 5 &kp F13>;
            label = "F13LAY6";
        };
    };

    behaviors {
        ef13laym: ef13laym {
            compatible = "zmk,behavior-hold-tap";
            label = "EF13LAYM";
            bindings = <&f13lay6>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Main {
            display-name = "Main";
            bindings = <
&kp TAB       &kp Q  &kp L  &kp U                    &kp COMMA    &kp PERIOD      &kp F          &kp W      &kp R         &kp Y  &kp P  &kp DEL
&kp LEFT_ALT  &kp E  &kp I  &kp A                    &kp O        &kp MINUS       &kp K          &kp T      &kp N         &kp S  &kp H  &kp SLASH
&kp LEFT_WIN  &kp X  &kp Z  &kp C                    &kp V        &kp SQT         &kp G          &kp D      &kp M         &kp J  &kp B  &lt 3 RIGHT_SHIFT
                            &mt LCTRL LC(RC(SPACE))  &lt 1 SPACE  &kp LEFT_SHIFT  &kp BACKSPACE  &kp ENTER  &lt 2 ESCAPE
            >;
        };

        symbol {
            display-name = "Left";
            bindings = <
&trans  &HankakuKakkoHidiri  &HankakuKakkoMigi  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp GRAVE  &kp SLASH             &kp LESS_THAN   &kp GREATER_THAN  &kp CARET      &kp ASTERISK   &trans
&trans  &kp QUESTION         &kp EXCLAMATION    &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp TILDE  &kp NON_US_BACKSLASH  &kp LEFT_BRACE  &kp RIGHT_BRACE   &kp SEMICOLON  &kp COLON      &trans
&trans  &none                &kp DOLLAR         &kp HASH              &kp AT_SIGN            &trans     &kp PIPE              &kp EQUAL       &kp PLUS          &kp PERCENT    &kp AMPERSAND  &trans
                                                &trans                &trans                 &trans     &trans                &trans          &trans
            >;
        };

        Others {
            display-name = "Conflg";
            bindings = <
&trans  &kp F9  &kp F10  &kp F11  &kp F12  &none   &kp PAGE_UP    &kp HOME        &kp UP_ARROW  &kp END          &msc SCRL_UP    &to 4
&trans  &kp F5  &kp F6   &kp F7   &kp F8   &none   &kp PAGE_DOWN  &kp LEFT        &kp DOWN      &kp RIGHT        &msc SCRL_DOWN  &to 6
&trans  &kp F1  &kp F2   &kp F3   &kp F4   &none   &none          &msc SCRL_LEFT  &none         &msc SCRL_RIGHT  &none           &none
                         &trans   &trans   &trans  &trans         &trans          &trans
            >;
        };

        number {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &kp PLUS   &kp N7        &kp N8        &kp N9        &kp MINUS     &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp EQUAL  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp ASTERISK  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp SLASH  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans        &trans
                        &trans  &trans  &trans  &trans     &trans        &kp N0
            >;
        };

        Move-mouse {
            display-name = "Right";
            bindings = <
&trans  &none           &msc SCRL_UP       &mmv MOVE_Y(-600)  &msc SCRL_DOWN    &none            &kp PRINTSCREEN  &none   &none   &sys_reset  &bt BT_SEL 0  &to 0
&trans  &msc SCRL_LEFT  &mmv MOVE_X(-600)  &mmv MOVE_Y(600)   &mmv MOVE_X(600)  &msc SCRL_RIGHT  &none            &none   &none   &bt BT_CLR  &bt BT_SEL 1  &to 0
&trans  &none           &none              &none              &sys_reset        &bootloader      &none            &none   &none   &bt BT_NXT  &bt BT_SEL 2  &to 0
                                           &mkp MB4           &mkp MB1          &mkp MB2         &trans           &trans  &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans   &trans    &trans    &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp F13  &trans    &trans    &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans   &trans    &mkp MB3  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                         &mkp MB4  &mkp MB1  &mkp MB2  &trans  &trans  &trans
            >;
        };

        Game {
            bindings = <
&kp ESCAPE      &kp TAB  &kp Q  &kp W     &kp E      &kp R      &kp F3  &kp N7        &kp N8        &kp N9        &kp F5  &to 0
&kp LEFT_SHIFT  &kp G    &kp A  &kp S     &kp D      &kp F      &kp F2  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp N0  &to 0
&kp LCTRL       &kp B    &kp Z  &kp X     &kp C      &kp V      &kp F1  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp F4  &to 0
                                &kp LEFT  &kp SPACE  &kp RIGHT  &trans  &trans        &trans
            >;
        };
    };
};
